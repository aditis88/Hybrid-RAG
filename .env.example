# Copy to .env and fill in values. Never commit .env.

# --- Embeddings (local BGE preferred; no key required for local) ---
# EMBEDDING_BACKEND=local
# HUGGINGFACEHUB_API_TOKEN=

# --- Gemini (Stage 4+ final answer generation only) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional legacy demo LLMs (compare path) ---
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- Retrieval / rerank knobs ---
# CANDIDATE_K=20
# RRF_TOP_N=20
# RERANK_TOP_K=5
# RRF_K=60
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
